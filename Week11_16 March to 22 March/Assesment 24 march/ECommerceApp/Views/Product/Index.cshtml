@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">

    <h2 class="text-center text-primary mb-4">🛍️ Our Products</h2>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-lg mb-4 text-center p-3">

                    <h5 class="card-title">@item.Name</h5>

                    <p class="text-success fw-bold fs-5">₹ @item.Price</p>

                    <p class="text-muted">
                        Category: @item.Category?.Name
                    </p>

                    <div class="d-flex justify-content-center gap-2">

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                            View
                        </a>

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </div>

                </div>
            </div>
        }

    </div>

    <div class="text-center mt-3">
        <a asp-action="Create" class="btn btn-primary">➕ Add New Product</a>
    </div>

</div>
