
@{
    ViewData["Title"] = "EmployeesByProject";
}

@* <h1>EmployeesByProject</h1> *@
@model IEnumerable<EmployeeProjectManagement.Models.Employee>

<h2>Employees Working On Project</h2>

<table class="table">
    <tr>
        <th>Employee Name</th>
    </tr>

    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Name</td>
        </tr>
    }

</table>
